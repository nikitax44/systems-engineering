@startuml
' Entity: users
class users {
    +id : BYTEA <<PK>>
    +s_pk : BYTEA
    +c_pk : BYTEA
    +expires : TIMESTAMP
    {constraint chk_id_length: octet_length(id) = 32}
}

' Entity: messages
class messages {
    +destination : BYTEA
    +payload : BYTEA
}

' Relationships
users "1" <-- "0..*" messages : FK destination
messages ..> users : destination

' Index
users ..> idx_users_expire : index on expires
@enduml
